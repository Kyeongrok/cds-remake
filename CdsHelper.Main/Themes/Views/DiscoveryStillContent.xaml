<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:CdsHelper.Main.UI.Views">

    <Style TargetType="{x:Type views:DiscoveryStillContent}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:DiscoveryStillContent}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  어디서 읽었는지 · 몇 장인지  -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Margin="0,0,0,8"
                            Foreground="Gray"
                            Text="{Binding Note}"
                            TextTrimming="CharacterEllipsis" />

                        <!--  왼쪽: 그림 목록. 줄에 작은 미리보기를 붙인다  -->
                        <ListBox
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalContentAlignment="Stretch"
                            ItemsSource="{Binding Stills}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding Selected, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="40"
                                            Height="40"
                                            BorderBrush="#40000000"
                                            BorderThickness="1">
                                            <Image Source="{Binding Image}" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!--  오른쪽: 고른 그림을 크게  -->
                        <Grid
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Background="#20000000"
                                BorderBrush="#40000000"
                                BorderThickness="1">
                                <Image
                                    Margin="8"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                                    Source="{Binding Selected.Image}"
                                    Stretch="Uniform" />
                            </Border>

                            <StackPanel
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                Orientation="Horizontal">
                                <TextBlock FontWeight="Bold" Text="{Binding Selected.Title}" />
                                <TextBlock
                                    Margin="12,0,0,0"
                                    Foreground="Gray"
                                    Text="{Binding Selected.Size}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
