<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- D3D 렌더러가 매핑된 GPU 버퍼에 직접 쓴다 (UI/Views/MapD3DRenderer.cs) -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="MoonSharp" Version="2.0.0" />
      <PackageReference Include="Prism.Core" Version="9.0.537" />
      <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
      <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
      <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CdsHelper.Support\CdsHelper.Support.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- 모드 「리디바탕 글꼴」(UI/Views/UiFont.cs). 리디바탕은 SIL OFL 1.1 이라 라이선스 전문을 함께 싣는다. -->
      <Resource Include="Fonts\RIDIBatang.otf" />
      <None Include="Fonts\RIDIBatang-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Engine\Battle\" />
      <Folder Include="Engine\Menu\" />
    </ItemGroup>

    <!-- 하드코어 랭킹 서명 열쇠 — 릴리즈 빌드가 GitHub 비밀(HARDCORE_KEY)을 환경 변수로 넘긴다. 손으로 빌드하면 비어 있다. -->
    <ItemGroup Condition="'$(HARDCORE_KEY)' != ''">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>HardcoreKey</_Parameter1>
        <_Parameter2>$(HARDCORE_KEY)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>

</Project>
