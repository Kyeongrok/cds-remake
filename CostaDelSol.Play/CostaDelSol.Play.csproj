      </Content>
      <Content Include="..\CdsHelper\PEX.json">
        <Link>PEX.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\PDG.json">
        <Link>PDG.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\PHT.json">
