<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <RootNamespace>CostaDelSol.Play</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <!-- 게임 exe 는 제 아이콘을 쓴다. 뷰어(CdsHelper.exe)와 나란히 놓이므로 아이콘까지 같으면 어느 쪽인지 알아볼 수가 없다. -->
        <ApplicationIcon>play.ico</ApplicationIcon>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <AssemblyName>CostaDelSol</AssemblyName>
        <Version>1.12.0</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    </PropertyGroup>

    <!-- 게임 화면이 파일로 읽는 것들. 뷰어 exe 와 같은 폴더에 놓이므로 한 벌만 있으면 된다. -->
    <ItemGroup>
      <Content Include="..\asset\**\*">
        <Link>asset\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <!-- BGM은 릴리즈의 별도 bgm.zip으로 배포하고 실행 파일에는 넣지 않는다. -->
      <Content Remove="..\asset\bgm\**\*" />
      <!-- 예시 애드온과 설명서(AddOnHost) — 애드온 폴더가 비었으면 처음 켤 때 베껴 준다. -->
      <Content Include="..\addons\**\*">
        <Link>AddOnSamples\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <!-- 화면 글 번역표(Lang) — 일본어 따위. -->
      <Content Include="..\lang\*.json">
        <Link>lang\%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\exe-tables\**\*.json">
        <Link>exe-tables\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <!-- 업데이트한 뒤 처음 켤 때 띄우는 릴리즈 노트(ReleaseNotes). -->
      <Content Include="..\릴리즈노트.md">
        <Link>release-notes.md</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <!-- 게임 통계를 받는 곳의 주소(PlayStats). 비어 있으면 아무것도 안 보낸다. -->
      <Content Include="..\stats-url.txt">
        <Link>stats-url.txt</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\cities.json">
        <Link>cities.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\books.json">
        <Link>books.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\patrons.json">
        <Link>patrons.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\figurehead.json">
        <Link>figurehead.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\item.json">
        <Link>item.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\hint.json">
        <Link>hint.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\discovery-master.json">
        <Link>discovery-master.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\disev.json">
        <Link>disev.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\story0.json">
        <Link>story0.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\story1.json">
        <Link>story1.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\PEX.json">
        <Link>PEX.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\PDG.json">
        <Link>PDG.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\PHT.json">
        <Link>PHT.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\PCQ.json">
        <Link>PCQ.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\EEX.json">
        <Link>EEX.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\EDG.json">
        <Link>EDG.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\EHT.json">
        <Link>EHT.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\ECQ.json">
        <Link>ECQ.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="..\CdsHelper\persons.json">
        <Link>persons.json</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <!-- 설치판의 메인 exe 라 Velopack 초기화·업데이트를 여기서도 한다. 개발도구와 같은 판을 쓴다. -->
      <PackageReference Include="Velopack" Version="0.0.1298" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CdsHelper.Game\CdsHelper.Game.csproj" />
      <ProjectReference Include="..\CdsHelper.Maze\CdsHelper.Maze.csproj" />
      <ProjectReference Include="..\CdsHelper.Duel\CdsHelper.Duel.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="..\asset\video\">
        <Link>asset\video</Link>
      </Folder>
      <Folder Include="asset\video\" />
    </ItemGroup>

</Project>
