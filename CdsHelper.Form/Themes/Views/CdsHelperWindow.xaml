<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="clr-namespace:CdsHelper.Navigation.UI.Views;assembly=CdsHelper.Navigation"
    xmlns:units="clr-namespace:CdsHelper.Support.UI.Units;assembly=CdsHelper.Support"
    xmlns:views="clr-namespace:CdsHelper.Form.UI.Views">

    <!--  타이틀바 버튼 스타일  -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#3A6EA5" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#2A5A8A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  닫기 버튼 스타일  -->
    <Style
        x:Key="CloseButtonStyle"
        BasedOn="{StaticResource TitleBarButtonStyle}"
        TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderThickness="0">
                        <ContentPresenter
                            x:Name="content"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E81123" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F1707A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type views:CdsHelperWindow}">
        <Setter Property="Title" Value="{Binding WindowTitle}" />
        <!--
            창의 첫 크기. 뜨는 자리(화면 한가운데)는 코드에서 정한다 —
            WindowStartupLocation 은 의존 속성이 아니라 Setter 에 넣을 수 없다.
        -->
        <Setter Property="Width" Value="1280" />
        <Setter Property="Height" Value="640" />
        <Setter Property="Background" Value="#F5F5F5" />
        <Setter Property="BorderBrush" Value="#104F89" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:CdsHelperWindow}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  커스텀 타이틀바  -->
                            <Border
                                x:Name="PART_TitleBar"
                                Grid.Row="0"
                                Background="#104F89">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--
                                        햄버거 버튼 (클릭 시 네비게이션 팝업). 제목 줄 맨 왼쪽이다 —
                                        WindowChrome 이 먹지 않도록 히트테스트를 따로 켠다.
                                    -->
                                    <Button
                                        x:Name="PART_HamburgerButton"
                                        Grid.Column="0"
                                        Padding="10,6"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip="탐색 메뉴"
                                        WindowChrome.IsHitTestVisibleInChrome="True">
                                        <Path
                                            Width="16"
                                            Height="12"
                                            VerticalAlignment="Center"
                                            Data="M 0 0 H 16 M 0 5 H 16 M 0 10 H 16"
                                            Stroke="White"
                                            StrokeThickness="2" />
                                    </Button>

                                    <!--  아이콘  -->
                                    <Image
                                        Grid.Column="1"
                                        Width="20"
                                        Height="20"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Source="{TemplateBinding Icon}"
                                        WindowChrome.IsHitTestVisibleInChrome="True" />

                                    <!--  제목  -->
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{TemplateBinding Title}" />

                                    <!--  윈도우 컨트롤 버튼  -->
                                    <StackPanel
                                        Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                        <Button x:Name="PART_MinimizeButton" Style="{StaticResource TitleBarButtonStyle}">
                                            <Path
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M 0 0 H 10"
                                                Stroke="White"
                                                StrokeThickness="1" />
                                        </Button>
                                        <Button x:Name="PART_MaximizeButton" Style="{StaticResource TitleBarButtonStyle}">
                                            <Rectangle
                                                Width="10"
                                                Height="10"
                                                Stroke="White"
                                                StrokeThickness="1" />
                                        </Button>
                                        <Button
                                            x:Name="PART_RestoreButton"
                                            Style="{StaticResource TitleBarButtonStyle}"
                                            Visibility="Collapsed">
                                            <Grid>
                                                <Rectangle
                                                    Width="8"
                                                    Height="8"
                                                    Margin="0,2,2,0"
                                                    Stroke="White"
                                                    StrokeThickness="1" />
                                                <Rectangle
                                                    Width="8"
                                                    Height="8"
                                                    Margin="2,0,0,2"
                                                    Stroke="White"
                                                    StrokeThickness="1" />
                                            </Grid>
                                        </Button>
                                        <Button x:Name="PART_CloseButton" Style="{StaticResource CloseButtonStyle}">
                                            <Path
                                                Data="M 0 0 L 10 10 M 0 10 L 10 0"
                                                Stroke="White"
                                                StrokeThickness="1" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  메뉴바  -->
                            <Grid Grid.Row="1" Background="#FAFAFA">
                                <Menu
                                    Background="#FAFAFA"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="0,0,0,1">
                                    <MenuItem x:Name="PART_SettingsMenu" Header="설정" />
                                    <MenuItem
                                        x:Name="PART_ShipMapMenu"
                                        Header="렌더링"
                                        ToolTip="함대 보기 (Direct3D)" />
                                    <MenuItem Header="도구">
                                        <MenuItem x:Name="PART_WorldMapMenu" Header="세계지도" />
                                        <MenuItem x:Name="PART_SphinxMenu" Header="스핑크스" />
                                        <MenuItem x:Name="PART_EventQueueMenu" Header="이벤트 큐 보기" />
                                        <MenuItem x:Name="PART_DbTableViewerMenu" Header="DB 테이블 보기" />
                                        <MenuItem
                                            x:Name="PART_MenuDesignerMenu"
                                            Header="메뉴 디자이너"
                                            ToolTip="게임에 나는 명령 창·물음창·목록을 손잡이로 짜 보고 눈으로 맞댄다" />
                                        <MenuItem
                                            x:Name="PART_MotionMakerMenu"
                                            Header="모션 메이커"
                                            ToolTip="일기토 그림 서른셋을 늘어놓고 번호를 적어 이어 돌려 본다 — 장마다 0.1초씩 맞춘다" />
                                        <MenuItem
                                            x:Name="PART_SoundTestMenu"
                                            Header="사운드테스트"
                                            ToolTip="번호 0~77 을 적어 소리를 튼다 — 0~27 은 CD 트랙, 28~77 은 WAVES.CDS 의 효과음 (게임 타이틀에 있던 줄을 옮겼다)" />
                                        <MenuItem
                                            x:Name="PART_UiSpriteDumpMenu"
                                            Header="화면 조각 뽑기"
                                            ToolTip="MISC.CDS 의 화면 조각을 PNG 로 뽑아 asset/ui 에 넣는다 — 손으로 다듬으려면 그림 파일이 있어야 한다" />
                                        <Separator />
                                        <MenuItem
                                            x:Name="PART_ImageShrinkMenu"
                                            Header="이미지 크기 줄이기"
                                            ToolTip="그림 파일을 골라 크기·용량을 줄인다" />
                                        <MenuItem
                                            x:Name="PART_VideoShrinkMenu"
                                            Header="동영상 줄이기"
                                            ToolTip="동영상의 크기를 줄이고, 소리(배경음악)를 빼고, 압축해 MP4 로 쓴다" />
                                    </MenuItem>
                                    <!--  요소 — 게임에 나오는 것들(나라·사람·배)을 고친다  -->
                                    <MenuItem Header="요소">
                                        <MenuItem
                                            x:Name="PART_NationEditMenu"
                                            Header="국가"
                                            ToolTip="나라 이름·쓰는 말·수도를 고친다 — 고친 것은 놀이에도 그대로 쓰인다" />
                                        <MenuItem
                                            x:Name="PART_CultureEditMenu"
                                            Header="문화권"
                                            ToolTip="도시마다의 문화권을 고친다 — 시설 화자 얼굴·술집 손님도 따라 바뀐다" />
                                        <MenuItem
                                            x:Name="PART_PersonEditMenu"
                                            Header="인물"
                                            ToolTip="세이브의 인물 281명을 고친다 — 이름·나이·자리·고용·이동 갈래·기술·언어" />
                                        <MenuItem
                                            x:Name="PART_ShipRegistryMenu"
                                            Header="선박"
                                            ToolTip="조선소에 낼 배를 등록한다" />
                                        <MenuItem
                                            x:Name="PART_FigureheadEditMenu"
                                            Header="선수상"
                                            ToolTip="선수상 서른여섯의 등급을 고친다 — 막을 확률(등급x30−20)과 다는 삯이 놀이에 바로 든다" />
                                        <MenuItem
                                            x:Name="PART_VoyagerEditMenu"
                                            Header="경쟁자"
                                            ToolTip="역사 항해자 열넷이 언제 무엇을 채가는지 고친다 — 고친 것은 놀이에도 그대로 쓰인다" />
                                        <MenuItem
                                            x:Name="PART_BuildingListMenu"
                                            Header="건물"
                                            ToolTip="도시마다 선 건물을 본다 — 자리와 가르치는 기능·언어까지" />
                                        <MenuItem
                                            x:Name="PART_PortraitBookMenu"
                                            Header="초상화 보기"
                                            ToolTip="MALE.CDS · FEMALE.CDS 의 얼굴을 번호와 함께 본다" />
                                    </MenuItem>
                                    <!--  에셋 — 게임 파일에 든 소리·그림 따위를 본다  -->
                                    <MenuItem Header="에셋">
                                        <MenuItem
                                            x:Name="PART_DiscoveryStillMenu"
                                            Header="발견물 그림"
                                            ToolTip="DSTILL.CDS 의 발견물 그림을 골라 본다" />
                                        <MenuItem
                                            x:Name="PART_WaveBankMenu"
                                            Header="효과음 보기"
                                            ToolTip="WAVES.CDS 에 든 게임 효과음" />
                                        <MenuItem
                                            x:Name="PART_MovieBankMenu"
                                            Header="동영상 보기"
                                            ToolTip="게임 AVI 동영상을 틀어 보고, 갈아 끼울 동영상을 asset/movie 에 올린다 — 올린 것이 있으면 놀이가 그것을 먼저 튼다" />
                                    </MenuItem>
                                    <MenuItem Header="개발">
                                        <MenuItem
                                            x:Name="PART_GameDataMenu"
                                            Header="게임데이터"
                                            ToolTip="앱이 EXE 에서 읽어 적어 둔 표들을 들여다보고 다시 굽는다" />
                                        <MenuItem
                                            x:Name="PART_CityCultureMenu"
                                            Header="도시 · 문화권 · 왕국"
                                            ToolTip="도시마다의 문화권·왕국을 갈아 씌운다 — 시설 화자 얼굴도 따라 바뀐다" />
                                        <MenuItem
                                            x:Name="PART_DisevEditorMenu"
                                            Header="발견 이벤트"
                                            ToolTip="DISEV.CDS 의 발견 이벤트 스크립트를 보고 고친다" />
                                        <MenuItem
                                            x:Name="PART_FormationMenu"
                                            Header="부대 편성"
                                            ToolTip="적이 내는 부대 세트 여덟 벌을 보고 고친다 — 맘루크·예니체리·사무라이가 무엇을 데리고 나오는지" />
                                        <MenuItem
                                            x:Name="PART_FortuneMenu"
                                            Header="운명 자리"
                                            ToolTip="여급 127명의 궁합 코드를 보고 고친다 — 어느 운명 자리에 여급이 몇이나 있는지" />
                                        <MenuItem
                                            x:Name="PART_TavernHintMenu"
                                            Header="힌트"
                                            ToolTip="힌트 186줄을 보고 고치거나 새로 더한다 — 어느 발견물을 가리키는지, 어느 책에 물려 있는지는 곁다리로 함께 낸다(술집이 이르는 방향은 그중 한 칸일 뿐이다)" />
                                        <MenuItem
                                            x:Name="PART_DiscoveryEditMenu"
                                            Header="발견물"
                                            ToolTip="발견물 274줄을 보고 고치거나, 원본에 없던 새 발견물을 더한다" />
                                        <MenuItem
                                            x:Name="PART_BookEditMenu"
                                            Header="책"
                                            ToolTip="책 257권을 보고 고치거나, 원본에 없던 새 책을 더한다 — 힌트는 책에 물려야 도서관에서 읽어 얻어진다" />
                                    </MenuItem>
                                    <MenuItem x:Name="PART_HelpMenu" Header="도움말" />
                                </Menu>

                                <!--  네비게이션 플로팅 팝업 (햄버거 버튼 클릭 시 펼쳐짐)  -->
                                <Popup
                                    x:Name="PART_MenuPopup"
                                    AllowsTransparency="True"
                                    Placement="Bottom"
                                    PlacementTarget="{Binding ElementName=PART_HamburgerButton}"
                                    StaysOpen="False">
                                    <Border
                                        Width="220"
                                        Background="White"
                                        BorderBrush="#1A6BB5"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="8"
                                                Opacity="0.3"
                                                ShadowDepth="2" />
                                        </Border.Effect>
                                        <nav:NavigationMenu x:Name="PART_AccordionMenu" />
                                    </Border>
                                </Popup>
                            </Grid>

                            <!--  세이브 파일 정보 바  -->
                            <Border
                                Grid.Row="2"
                                Padding="10,5"
                                Background="#E3F2FD"
                                BorderBrush="#90CAF9"
                                BorderThickness="0,0,0,1">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Width="120"
                                        Height="28"
                                        Margin="0,0,5,0"
                                        Background="#1976D2"
                                        BorderThickness="0"
                                        Command="{Binding LoadSaveCommand}"
                                        Content="세이브 파일 열기"
                                        Cursor="Hand"
                                        Foreground="White">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="border"
                                                    Padding="10,5"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#1565C0" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#0D47A1" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Margin="0,0,15,0"
                                        Background="#1976D2"
                                        BorderThickness="0"
                                        Command="{Binding RefreshSaveCommand}"
                                        Cursor="Hand"
                                        ToolTip="마지막으로 로드한 세이브 파일을 다시 로드합니다">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    x:Name="border"
                                                    Padding="5"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="3">
                                                    <Path
                                                        x:Name="icon"
                                                        Width="16"
                                                        Height="16"
                                                        Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                                        Fill="White"
                                                        Stretch="Uniform" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#388E3C" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#2E7D32" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="border" Property="Background" Value="#BDBDBD" />
                                                        <Setter TargetName="icon" Property="Fill" Value="#9E9E9E" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="#555">
                                        <Run Text="파일:" />
                                    </TextBlock>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="#1976D2"
                                        Text="{Binding FilePath}" />
                                </StackPanel>
                            </Border>

                            <!--  메인 컨텐츠 영역 (사이드 메뉴는 햄버거 팝업으로 이동)  -->
                            <Grid Grid.Row="3" Background="#F5F5F5">
                                <ContentControl x:Name="PART_ContentRegion" Margin="5" />
                            </Grid>

                            <!--  하단 상태바  -->
                            <StatusBar Grid.Row="4" Background="#104F89">
                                <StatusBarItem>
                                    <TextBlock Foreground="White" Text="{Binding DataContext.StatusText, RelativeSource={RelativeSource TemplatedParent}}" />
                                </StatusBarItem>
                                <StatusBarItem HorizontalAlignment="Right">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="#B0C4DE"
                                        Text="{Binding DataContext.FilePath, RelativeSource={RelativeSource TemplatedParent}}" />
                                </StatusBarItem>
                            </StatusBar>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_MaximizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_RestoreButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="PART_TitleBar" Property="Background" Value="#6B6B6B" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
