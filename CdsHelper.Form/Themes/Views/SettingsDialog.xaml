<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:CdsHelper.Form.UI.Views">

    <Style TargetType="{x:Type views:SettingsDialog}">
        <Setter Property="Background" Value="Azure" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:SettingsDialog}">
                    <Border Background="{TemplateBinding Background}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 일반 설정 -->
                        <GroupBox Grid.Row="0" Header="일반 설정" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="시작 화면:" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox x:Name="PART_DefaultViewComboBox" Grid.Column="1"
                                          Height="25" VerticalAlignment="Center" />
                            </Grid>
                        </GroupBox>

                        <!-- 마커 크기 설정 -->
                        <GroupBox Grid.Row="1" Header="지도 설정" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="마커 크기:" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Slider x:Name="PART_MarkerSizeSlider" Grid.Column="1"
                                        Minimum="4" Maximum="20" Value="8"
                                        TickFrequency="2" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Value, ElementName=PART_MarkerSizeSlider, StringFormat={}{0:F0}}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </GroupBox>

                        <!-- 렌더링 -->
                        <GroupBox Grid.Row="2" Header="렌더링" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <CheckBox x:Name="PART_AutoOpenShipMapCheckBox"
                                          Content="앱을 켤 때 함대 보기(Direct3D) 바로 열기"
                                          VerticalContentAlignment="Center" />
                                <TextBlock Text="끄면 메뉴의 '렌더링' 을 눌러야 열립니다."
                                           Foreground="Gray" FontSize="11" Margin="20,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>

                        <!-- 데이터 관리 -->
                        <GroupBox Grid.Row="3" Header="데이터 관리" Padding="10" Margin="0,10,0,0"
                                  VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="DB 파일을 삭제하려면 프로그램을 종료한 후 삭제하세요."
                                           Foreground="Gray" FontSize="11" Margin="0,0,0,10" />
                                <Button x:Name="PART_OpenDbFolderButton" Content="DB 파일 위치 열기"
                                        Width="120" Height="28" HorizontalAlignment="Left" />
                            </StackPanel>
                        </GroupBox>

                        <!-- 버튼 -->
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="PART_OkButton" Content="확인" Width="80" Height="30" Margin="0,0,10,0" IsDefault="True" />
                            <Button x:Name="PART_CancelButton" Content="취소" Width="80" Height="30" IsCancel="True" />
                        </StackPanel>
                    </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
